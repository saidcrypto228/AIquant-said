[Unit]
Description=QVEX FastAPI TMA Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qvex
ExecStart=/opt/qvex/venv/bin/uvicorn tma_server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3s

MemoryMax=350M
CPUQuota=40%

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
