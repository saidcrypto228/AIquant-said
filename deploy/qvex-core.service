[Unit]
Description=QVEX v10.7 Trading Core Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qvex
ExecStart=/opt/qvex/venv/bin/python -u hl_swing_bot.py
Restart=always
RestartSec=5s

# Защита ресурсов и лимиты
MemoryMax=1.5G
MemoryHigh=1.2G
CPUQuota=120%

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
